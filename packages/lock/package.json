{
  "name": "@nestjs-redis/lock",
  "version": "2.0.0-0",
  "license": "MIT",
  "type": "module",
  "author": "Saba Pochkhua <saba.pochkhua@gmail.com> (https://github.com/CSenshi)",
  "description": "Redis-based distributed lock module for NestJS, built on @redis-kit/lock",
  "keywords": [
    "nestjs",
    "redis",
    "lock",
    "distributed",
    "typescript",
    "node-redis",
    "redis-lock"
  ],
  "homepage": "https://github.com/CSenshi/nestjs-redis/tree/main/packages/lock",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit",
    "test": "vitest run",
    "lint": "oxlint"
  },
  "dependencies": {
    "@redis-kit/lock": "^0.1.0-3",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.0.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CSenshi/nestjs-redis",
    "directory": "packages/lock"
  }
