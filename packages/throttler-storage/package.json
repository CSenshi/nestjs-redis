{
  "name": "@nestjs-redis/throttler-storage",
  "version": "2.0.0-0",
  "license": "MIT",
  "type": "module",
  "author": "Saba Pochkhua <saba.pochkhua@gmail.com> (https://github.com/CSenshi)",
  "description": "Redis storage for NestJS Throttler enabling distributed rate limiting across multiple application instances",
  "keywords": [
    "nestjs",
    "redis",
    "throttler",
    "rate-limiting",
    "storage",
    "distributed",
    "typescript",
    "throttling"
  ],
  "homepage": "https://github.com/CSenshi/nestjs-redis/tree/main/packages/throttler-storage",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit",
    "test": "vitest run",
    "lint": "oxlint"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@nestjs/throttler": "^6.5.0",
    "redis": "^6.0.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CSenshi/nestjs-redis",
    "directory": "packages/throttler-storage"
  }
}
